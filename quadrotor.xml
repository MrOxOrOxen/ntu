<mujoco model="quadrotor">
    <compiler angle="radian"/>
    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="RK4"
    />
    <visual>
        <global offwidth="1280" offheight="720"/>
    </visual>

    <worldbody>
        <light pos="0 0 8" dir="0 0 -1" diffuse="1 1 1"/>
        <geom name="ground" type="plane" pos="0 0 0" size="10 10 0.1" rgba="0.8 0.8 0.8 1"/>
        <body name="quadrotor">
            <freejoint name="root"/>
            <inertial pos="0 0 0" mass="1.2" diaginertia="0.0125 0.0125 0.022"/>
            <geom type="box" size="0.08 0.06 0.025" rgba="0.2 0.2 0.8 1"/>
            <geom type="capsule" fromto="0 0 0 -0.225 0.225 0" size="0.012" rgba="0.2 0.2 0.2 1"/>
            <geom type="capsule" fromto="0 0 0 0.225 0.225 0" size="0.012" rgba="0.2 0.2 0.2 1"/>
            <geom type="capsule" fromto="0 0 0 0.225 -0.225 0" size="0.012" rgba="0.2 0.2 0.2 1"/>
            <geom type="capsule" fromto="0 0 0 -0.225 -0.225 0" size="0.012" rgba="0.2 0.2 0.2 1"/>
            <geom type="cylinder" pos="-0.225 0.225 0" size="0.05 0.006" rgba="0.9 0.2 0.2 1"/>
            <geom type="cylinder" pos="0.225 0.225 0" size="0.05 0.006" rgba="0.2 0.9 0.2 1"/>
            <geom type="cylinder" pos="0.225 -0.225 0" size="0.05 0.006" rgba="0.2 0.2 0.9 1"/>
            <geom type="cylinder" pos="-0.225 -0.225 0" size="0.05 0.006" rgba="0.9 0.9 0.2 1"/>
            <site name="imu_site" pos="0 0 0" size="0.01"/>
        </body>
    </worldbody>
    <sensor>
        <accelerometer name="imu_accel" site="imu_site"/>
        <gyro name="imu_gyro" site="imu_site"/>
    </sensor>
</mujoco>